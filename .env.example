# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side ONLY, never exposed to the browser.
# Used only by /src/app/api/admin/invite-user/route.ts to create agent/professional/client logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

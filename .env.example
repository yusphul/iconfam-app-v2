# Supabase project settings (Project Settings -> API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — server-side ONLY, never exposed to the browser.
# Used only by /src/app/api/admin/invite-user/route.ts to create agent/professional/client logins.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (sent through Resend, resend.com) ---------------------------------
# Without RESEND_API_KEY the app still works; emails wait in the queue and go out
# once this is set. EMAIL_FROM's domain must be verified in Resend.
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM="iConfam <hello@iconfam.com>"
EMAIL_REPLY_TO=hello@iconfam.com
# Used for the links inside emails (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://app.iconfam.com
# Protects the daily reminder job (/api/cron/reminders). Vercel sends it automatically.
CRON_SECRET=make-up-a-long-random-string

# --- Card payments (optional; Stripe) ----------------------------------------
# STRIPE_SECRET_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# NEXT_PUBLIC_STRIPE_ENABLED=true

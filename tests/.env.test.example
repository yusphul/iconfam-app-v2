# Copy this to .env.test.local (already gitignored) and fill in real values.
#
# IMPORTANT: point this at a Supabase project you're comfortable seeding and
# deleting real test data in — a staging project, not production. The test
# suite creates and deletes real auth users and a real case on every run.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The URL Playwright drives — your local dev server or a deployed environment.
PLAYWRIGHT_BASE_URL=http://localhost:3000

# Shared password for all four seeded test accounts. Change it to anything —
# it only ever exists in your test project.
E2E_TEST_PASSWORD=IconfamTest!2026
